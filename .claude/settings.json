{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(shasum:*)",
      "Bash(file:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(sudo:*)",
      "Bash(python3 *skillgate.py release*)",
      "Bash(python *skillgate.py release*)",
      "Bash(python3 *skillgate.py adopt*)",
      "Bash(python *skillgate.py adopt*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/chapters/09-skill-security/skillgate.py hook"
          }
        ]
      }
    ]
  }
}
